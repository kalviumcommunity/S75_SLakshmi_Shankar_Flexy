# Production Environment Variables
# Use this when deploying to production (Render, Railway, Heroku, etc.)

NODE_ENV=production
PORT=5000

# MongoDB Connection - Same database for production
# NOTE: Consider creating a separate production database cluster for better isolation
MONGO_URI=mongodb+srv://root:root@cluster0.bh2pwj8.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret - SECURE PRODUCTION SECRET
# ⚠️ CRITICAL: This is a randomly generated secure secret
# DO NOT share this publicly or commit to Git
JWT_SECRET=WdFvFEEsPiiqFgZx8tW42C7AulXayIA9yqt75aEJEAuSKOpl/6MyNBGp2/C4HlfBdVIuGT6qd8CRNtBSWjTPCQ==

# Cookie Domain - Set based on your hosting platform
# For Netlify frontend + Render backend: use your Render domain
# Example for Render: .onrender.com
# Example for Railway: .railway.app
# Example for your own domain: .yourdomain.com
COOKIE_DOMAIN=

# Frontend URL - Your production frontend (Netlify)
FRONTEND_URL=https://flexy-life.netlify.app

# Rate Limiting (stricter for production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Trust Proxy (important for production behind reverse proxy)
TRUST_PROXY=true
